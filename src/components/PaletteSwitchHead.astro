---
/**
 * Script anti-parpadeo del switch de paletas.
 *
 * Va dentro de <head>, antes de cualquier contenido, para que la paleta quede
 * aplicada en el primer render y no se vea un cambio de color al refrescar.
 * La UI del switch está en PaletteSwitch.astro.
 *
 * Orden de resolución:
 *   1. `?palette=` en la URL (para mandarle al doctor un link con una paleta).
 *   2. `localStorage`, dentro de try/catch (Safari en privado lanza excepción).
 *   3. La paleta por defecto, que ya viene en el atributo del servidor.
 *
 * Solo se renderiza mientras el switch está visible: con
 * PUBLIC_SHOW_PALETTE_SWITCH=false la paleta la fija el servidor y un valor
 * viejo en localStorage no puede alterar la página publicada.
 */
import {
  CLAVE_PALETA,
  PARAMETRO_PALETA,
  idsHabilitados,
  paletaPorDefecto,
} from '../config/palettes';
---

<script
  is:inline
  define:vars={{
    paletaIds: idsHabilitados,
    paletaDef: paletaPorDefecto,
    paletaClave: CLAVE_PALETA,
    paletaParam: PARAMETRO_PALETA,
  }}
>
  (function () {
    let elegida = null;
    let desdeUrl = null;

    try {
      desdeUrl = new URL(window.location.href).searchParams.get(paletaParam);
    } catch {
      /* URL no analizable: se ignora y se sigue con localStorage. */
    }

    if (desdeUrl && paletaIds.indexOf(desdeUrl) !== -1) {
      elegida = desdeUrl;
      try {
        window.localStorage.setItem(paletaClave, elegida);
      } catch {
        /* Almacenamiento bloqueado: la paleta vale solo para esta vista. */
      }
    } else {
      try {
        const guardada = window.localStorage.getItem(paletaClave);
        if (guardada && paletaIds.indexOf(guardada) !== -1) {
          elegida = guardada;
        }
      } catch {
        /* Almacenamiento bloqueado: se usa la paleta por defecto. */
      }
    }

    document.documentElement.setAttribute('data-palette', elegida || paletaDef);
  })();
</script>
