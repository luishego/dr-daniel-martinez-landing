---
/**
 * Switch de paletas para presentarle las dos opciones al Dr. Martínez sobre la
 * página real. Fijo en la esquina inferior derecha, lejos de los CTA del hero.
 *
 * Solo muestra las paletas habilitadas en `src/config/palettes.ts`: cuando el
 * doctor elija, se recorta esa lista y se pone PUBLIC_SHOW_PALETTE_SWITCH=false
 * para que el switch deje de renderizarse. Ningún otro componente cambia.
 *
 * El estado visual del botón activo lo resuelve el CSS a partir de
 * `html[data-palette]`, así que es correcto desde el primer render, antes de
 * que corra cualquier script. El script solo sincroniza `aria-pressed`,
 * persiste la elección y reescribe `?palette=`.
 */
import {
  CLAVE_PALETA,
  PARAMETRO_PALETA,
  idsHabilitados,
  paletaPorDefecto,
  paletasHabilitadas,
} from '../config/palettes';
---

<aside class="switch" id="switch-paletas" aria-label="Vista de presentación">
  <p class="switch__titulo" id="switch-paletas-titulo">
    Vista de presentación · paleta
  </p>
  <div class="switch__grupo" role="group" aria-labelledby="switch-paletas-titulo">
    {paletasHabilitadas.map((paleta) => (
      <button
        type="button"
        class="switch__boton"
        data-paleta={paleta.id}
        aria-pressed={paleta.id === paletaPorDefecto ? 'true' : 'false'}
        style={`--muestra-a: var(${paleta.muestras[0]}); --muestra-b: var(${paleta.muestras[1]});`}
      >
        <span class="switch__muestras" aria-hidden="true">
          <span class="switch__punto switch__punto--a" />
          <span class="switch__punto switch__punto--b" />
        </span>
        <span>{paleta.etiqueta}</span>
        <span class="visualmente-oculto">· {paleta.nombre}</span>
      </button>
    ))}
  </div>
</aside>

<script
  is:inline
  define:vars={{
    paletaIds: idsHabilitados,
    paletaDef: paletaPorDefecto,
    paletaClave: CLAVE_PALETA,
    paletaParam: PARAMETRO_PALETA,
  }}
>
  (function () {
    const raiz = document.documentElement;
    const botones = Array.prototype.slice.call(
      document.querySelectorAll('#switch-paletas [data-paleta]'),
    );

    function sincronizar(id) {
      botones.forEach(function (boton) {
        boton.setAttribute('aria-pressed', boton.dataset.paleta === id ? 'true' : 'false');
      });
    }

    sincronizar(raiz.getAttribute('data-palette') || paletaDef);

    botones.forEach(function (boton) {
      boton.addEventListener('click', function () {
        const id = boton.dataset.paleta;
        if (!id || paletaIds.indexOf(id) === -1) {
          return;
        }

        raiz.setAttribute('data-palette', id);
        sincronizar(id);

        try {
          window.localStorage.setItem(paletaClave, id);
        } catch {
          /* Almacenamiento bloqueado: la elección no sobrevive la recarga. */
        }

        try {
          const url = new URL(window.location.href);
          url.searchParams.set(paletaParam, id);
          window.history.replaceState({}, '', url);
        } catch {
          /* Sin URL reescribible: el switch sigue funcionando igual. */
        }
      });
    });
  })();
</script>

<style>
  .switch {
    position: fixed;
    right: clamp(0.75rem, 0.4rem + 1.5vw, 1.5rem);
    bottom: clamp(0.75rem, 0.4rem + 1.5vw, 1.5rem);
    z-index: var(--z-switch);
    display: flex;
    align-items: center;
    gap: 0.875rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radio-pastilla);
    background-color: var(--color-surface);
    box-shadow: 0 0.5rem 1.75rem rgb(0 0 0 / 16%);
  }

  .switch__titulo {
    font-size: 0.6875rem;
    font-weight: var(--peso-titulo);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .switch__grupo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .switch__boton {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--alto-control);
    padding-inline: 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radio-pastilla);
    background-color: transparent;
    color: var(--color-ink);
    font-size: 0.8125rem;
    font-weight: var(--peso-fuerte);
    white-space: nowrap;
    cursor: pointer;
  }

  .switch__muestras {
    display: inline-flex;
    align-items: center;
  }

  .switch__punto {
    display: inline-block;
    width: 0.8125rem;
    height: 0.8125rem;
    border-radius: 50%;
  }

  .switch__punto--a {
    background-color: var(--muestra-a);
  }

  .switch__punto--b {
    margin-left: -0.3125rem;
    background-color: var(--muestra-b);
  }

  /* El botón activo se resuelve desde el atributo del <html>, no desde JS:
     así el estado es correcto en el primer render y no parpadea. */
  :global(html[data-palette='b']) .switch__boton[data-paleta='b'],
  :global(html[data-palette='a']) .switch__boton[data-paleta='a'] {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-on-dark);
  }

  @media (max-width: 40rem) {
    .switch__titulo {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media print {
    .switch {
      display: none;
    }
  }
</style>
