---
/**
 * Sección Sobre el Doctor (HU-03). Presentación en primera persona,
 * credenciales y espacio para las cédulas, todo desde
 * `src/content/sobre/sobre.json`.
 */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import consultorio from '../../assets/dr-martinez-retrato-1.jpeg';

const sobre = await getEntry('sobre', 'sobre');
if (!sobre) {
  throw new Error('Falta src/content/sobre/sobre.json');
}

const { antetitulo, titulo, parrafos, imagen, tituloFormacion, formacion, cedulas } = sobre.data;
---

<section class="seccion sobre" id="sobre">
  <div class="contenedor sobre__fila">
    <div class="sobre__figura">
      <Image
        class="sobre__foto"
        src={consultorio}
        alt={imagen.alt}
        widths={[360, 480, 640, 853]}
        sizes="(min-width: 60rem) 24rem, min(100vw - 2rem, 24rem)"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="sobre__texto">
      <p class="antetitulo sobre__antetitulo">{antetitulo}</p>
      <h2 class="sobre__titulo">{titulo}</h2>
      {parrafos.map((parrafo) => (
        <p class="sobre__parrafo">{parrafo}</p>
      ))}

      <h3 class="etiqueta-seccion sobre__formacion-titulo">{tituloFormacion}</h3>
      <ul class="sobre__formacion">
        {formacion.map((dato) => (
          <li class="sobre__dato">
            <span class="sobre__vineta" aria-hidden="true" />
            {dato}
          </li>
        ))}
      </ul>
      <ul class="sobre__cedulas">
        {cedulas.map((cedula) => (
          <li class="pastilla">{cedula}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .sobre__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--espacio-columnas);
  }

  .sobre__figura {
    flex: 1 1 21.25rem;
    min-width: 0;
    max-width: 24rem;
  }
  .sobre__foto {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    border-radius: var(--radio-imagen-grande);
    background-color: var(--color-tint);
  }
  @media (max-width: 58.75rem) {
    .sobre__figura {
      margin-inline: auto;
    }
  }

  .sobre__texto {
    flex: 999 1 30rem;
    min-width: 0;
  }

  .sobre__antetitulo {
    margin-bottom: 0.875rem;
    color: var(--color-primary);
  }

  .sobre__titulo {
    margin-bottom: 1.375rem;
    font-size: var(--texto-h2);
    line-height: var(--alto-h2);
    letter-spacing: var(--espaciado-h2);
    color: var(--color-primary);
  }

  .sobre__parrafo {
    margin-bottom: 1.125rem;
  }

  .sobre__formacion-titulo {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .sobre__formacion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sobre__dato {
    display: flex;
    gap: 0.75rem;
    font-size: var(--texto-lista);
    line-height: 1.55;
  }
  .sobre__vineta {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.4375rem;
    border-radius: 50%;
    background-color: var(--color-secondary);
  }

  .sobre__cedulas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
