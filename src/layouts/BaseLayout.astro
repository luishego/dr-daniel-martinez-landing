---
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLdSitio from '../components/JsonLdSitio.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const sitio = await getEntry('sitio', 'sitio');
if (!sitio) {
  throw new Error('Falta src/content/sitio/sitio.json');
}

const { titulo = sitio.data.seo.titulo, descripcion = sitio.data.seo.descripcion } = Astro.props;

// Sin dominio configurado (`SITE_URL`) estamos en una preview o en desarrollo:
// no se indexa y no se declara canonical.
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {url ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.data.nombre} />
    {url && <meta property="og:url" content={url} />}
    <meta name="twitter:card" content="summary" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />

    <!-- Nunito autoalojada por Astro, con font-display: swap.
         Google la entrega como fuente variable, así que un solo archivo por
         subconjunto cubre los pesos 400, 700 y 800: se precarga el de `latin`,
         que es el que pinta el título del hero (el LCP de la página). El de
         `latin-ext` se queda sin precargar porque el hero no lo necesita. -->
    <Font cssVariable="--fuente-base" preload={[{ subset: 'latin' }]} />

    <JsonLdSitio />

    <!--
      Pendiente: imagen Open Graph (og:image) cuando el cliente entregue la
      fotografía; pide URL absoluta, así que depende también del dominio.
    -->
  </head>

  <body>
    <a class="salto" href="#contenido">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .salto {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: calc(var(--z-header) + 1);
    transform: translate(-50%, -120%);
    padding: 0.75rem 1.25rem;
    border-bottom-left-radius: var(--radio-campo);
    border-bottom-right-radius: var(--radio-campo);
    background-color: var(--color-primary);
    color: var(--color-on-dark);
    font-size: var(--texto-menu);
    font-weight: var(--peso-fuerte);
    text-decoration: none;
  }

  .salto:focus-visible {
    transform: translate(-50%, 0);
  }

  main:focus-visible {
    outline: none;
  }
</style>
