/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'

# Astro versiona los nombres de archivo, así que la caché puede ser perpetua.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# La política de scripts, estilos y marcos la emite Astro en un <meta> con hashes
# (`security.csp` en astro.config.mjs); aquí solo `frame-ancestors`, que no
# funciona en <meta>.
